{
  "name": "decky-tdp-tuner",
  "version": "0.1.0",
  "description": "Finds the lowest TDP that holds a target framerate on the Steam Deck",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidharthify/DeckyTDPTuner.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "tdp"
  ],
  "author": "sidharthify <wednisegit@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/sidharthify/DeckyTDPTuner/issues"
  },
  "homepage": "https://github.com/sidharthify/DeckyTDPTuner#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
